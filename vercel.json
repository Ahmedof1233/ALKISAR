{
  "version": 2,
  "rewrites": [
    {
      "source": "/admin/:match*",
      "destination": "/frontend/admin/dist/:match*"
    },
    {
      "source": "/admin",
      "destination": "/frontend/admin/dist/index.html"
    },
    {
      "source": "/track",
      "destination": "/frontend/customer/index.html"
    }
  ]
}
